# Antigravity Proxy Stack - Environment Template
# ⚠️ Copy this to .env and fill in your actual values
# ⚠️ NEVER commit .env with real keys to version control

# ==============================================
# REQUIRED API KEYS - Replace placeholders
# ==============================================

# Vercel AI Gateway (get from https://vercel.com/docs/ai-gateway)
VERCEL_AI_GATEWAY_API_KEY=your_vercel_gateway_key_here
VERCEL_AI_GATEWAY_URL=https://ai-gateway.vercel.sh/v1

# Vercel Platform Token (from Vercel dashboard)
VERCEL_TOKEN=your_vercel_token_here

# GitHub PAT (for GHCR image pushes)
GITHUB_TOKEN=your_github_token_here

# GitHub Fine-grained PAT (optional)
GITHUB_FINE_GRAINED_PAT=your_fine_grained_pat_here

# Railway API Token (from Railway dashboard)
RAILWAY_TOKEN=your_railway_token_here

# Remotion Render Token (from Remotion dashboard)
REMOTION_TOKEN=your_remotion_token_here

# OpenAI API Key (from platform.openai.com)
OPENAI_API_KEY=sk-your-openai-key-here

# Anthropic API Key (from console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Gemini API Key (from aistudio.google.com)
GEMINI_API_KEY=your-gemini-key-here

# ==============================================
# SERVICE CONFIGURATION
# ==============================================

# Upstream proxy (your existing VLESS/Clash/V2Ray)
AG_PROXY_HOST=127.0.0.1
AG_PROXY_PORT=7890
AG_PROXY_TYPE=socks5

# Service ports
HTTP_PORT=3003
HTTPS_PORT=8443
RATE_LIMIT_PER_MIN=100
