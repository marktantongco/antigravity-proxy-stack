# Copy to .env and fill in real values before running docker-compose
# NEVER commit this file with real tokens to version control

# Upstream proxy configuration (your existing Clash/V2Ray/Sing-box)
AG_PROXY_HOST=127.0.0.1
AG_PROXY_PORT=7890
AG_PROXY_TYPE=socks5

# AI service API keys
AG_API_KEY=your-openai-api-key-here
AG_CLAW_CODE_TOKEN=your-claw-code-codes-token-here

# Vercel AI Gateway (unified API endpoint for multiple providers)
VERCEL_AI_GATEWAY_API_KEY=your-vercel-gateway-key
VERCEL_AI_GATEWAY_URL=https://ai-gateway.vercel.sh/v1

# Vercel Platform Token (for deployments and edge functions)
VERCEL_TOKEN=your-vercel-token

# GitHub Personal Access Token (for GHCR, repo access)
GITHUB_TOKEN=your-github-token
GITHUB_USERNAME=your-username

# Service ports (do not change unless you know what you're doing)
AG_MANAGER_PORT=3000
AG_TOOLS_LS_PORT=3001
AG_PROXY_AI_PORT=3002

# Container references
ROUTER_CONTAINER=9router:latest
OPENCODE_URL=http://localhost:8000

# Billing configuration
RATE_LIMIT=1000
WINDOW_MS=3600000

# SSL certificate paths (update for production)
SSL_CERT_PATH=./nginx/ssl/cert.pem
SSL_KEY_PATH=./nginx/ssl/key.pem
